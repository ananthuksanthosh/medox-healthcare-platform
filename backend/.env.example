# ─────────────────────────────────────────────────────────────────────────────
# MEDOX Backend — Environment Variables
# Copy this file to .env and fill in your values before starting the server.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
# MySQL connection string
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:yourpassword@localhost:3306/medibee"

# ── JWT ─────────────────────────────────────────────────────────────────────
# REQUIRED — Must be a long, random, unpredictable secret string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_very_long_random_secret_string_at_least_64_chars

# ── Server ──────────────────────────────────────────────────────────────────
# Port to listen on (AWS/Docker will override this with its own PORT)
PORT=5000

# Node environment: "development" or "production"
# In production: disables query logging, hides error details from API responses
NODE_ENV=development

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Example for production: CORS_ORIGIN=https://medox.in,https://www.medox.in
# Leave unset to default to localhost:3000 / localhost:4000 (development)
CORS_ORIGIN=http://localhost:3000,http://localhost:4000

# ── File Upload ──────────────────────────────────────────────────────────────
# Base URL for generating public file share links
# In production, this should be your domain or S3/CloudFront URL
APP_URL=http://localhost:5000

# ── AWS (Production) ─────────────────────────────────────────────────────────
# Uncomment and fill when deploying to AWS
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=medox-uploads
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
